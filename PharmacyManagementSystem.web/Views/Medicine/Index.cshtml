@model IEnumerable<PharmacyManagementSystem.web.Models.Medicine>

<h1>Medicine Inventory</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Reorder Level</th>
            <th>Purchase Price</th>
            <th>Selling Price</th>
            <th>Prescription Required</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var medicine in Model)
        {
            <tr>
                <td>@medicine.Id</td>
                <td>@medicine.Name</td>
                <td>@medicine.CategoryId</td>
                <td>@medicine.QuantityInStock</td>
                <td>@medicine.ReorderLevel</td>
                <td>@medicine.PurchasePrice</td>
                <td>@medicine.SellingPrice</td>
                <td>@medicine.RequiresPrescription</td>
            </tr>
        }
    </tbody>
</table>