@model IEnumerable<PharmacyManagementSystem.web.Models.Medicine>

<h1>Medicines</h1>

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>SellingPrice</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var medicine in Model)
        {
            <tr>
                <td>@medicine.Id</td>
                <td>@medicine.Name</td>
                <td>@medicine.SellingPrice</td>
            </tr>
        }
    </tbody>
</table>
`